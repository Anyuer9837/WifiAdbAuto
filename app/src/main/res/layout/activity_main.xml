<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <!-- 小屏机型三张卡片放不下，整体可上下滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ADB 无线调试 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADB 无线调试"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2328"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="端口 5555，拨动即生效，重启后保持"
                android:textSize="12sp"
                android:textColor="#656D76"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/sw_adb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <LinearLayout
                android:id="@+id/row_cmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_cmd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#1F6FEB"
                    android:textIsSelectable="true"/>

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="56dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:stateListAnimator="@null"
                    android:text="复制"
                    android:textAllCaps="false"
                    android:textColor="#1F6FEB"
                    android:textSize="13sp"
                    app:backgroundTint="@color/btn_action_tint"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:rippleColor="#CFE2FF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 网页发现服务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="网页发现服务"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2328"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="端口 9837，电脑上可查 IP、复制命令、改同样的开关"
                android:textSize="12sp"
                android:textColor="#656D76"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/sw_web"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <LinearLayout
                android:id="@+id/row_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#1F6FEB"
                    android:textIsSelectable="true"/>

                <Button
                    android:id="@+id/btn_open"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="56dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:stateListAnimator="@null"
                    android:text="打开"
                    android:textAllCaps="false"
                    android:textColor="#1F6FEB"
                    android:textSize="13sp"
                    app:backgroundTint="@color/btn_action_tint"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:rippleColor="#CFE2FF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 无线调试（系统自带，非 root 也能用）：只给步骤，开关一律去系统设置里做 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="无线调试（非 Root 可用）"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2328"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android 11+ 系统自带，端口每次随机；本卡片只给步骤，开关请在系统设置里操作"
                android:textSize="12sp"
                android:textColor="#656D76"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_wifi_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#1F2328"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_sys_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="去开发者选项"
                    android:textAllCaps="false"
                    android:textColor="#1F6FEB"
                    android:textSize="13sp"
                    app:backgroundTint="@color/btn_action_tint"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:rippleColor="#CFE2FF"/>

                <Button
                    android:id="@+id/btn_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="查看完整步骤"
                    android:textAllCaps="false"
                    android:textColor="#1F6FEB"
                    android:textSize="13sp"
                    app:backgroundTint="@color/btn_action_tint"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:rippleColor="#CFE2FF"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- 应用中的遮罩：吃掉点击，避免快速连点并发执行 -->
    <LinearLayout
        android:id="@+id/view_blocking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在应用…"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

</FrameLayout>
